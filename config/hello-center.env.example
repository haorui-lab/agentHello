# 不要提交填好的副本。生成本地文件: scripts/init_local_env.sh
# 它写入 config/hello-center.env，权限 600，不打印口令。

# 登记新 Agent 的口令。至少 8 个字符。留空表示还没生成。
HELLO_REGISTER_SECRET=

# Redis 地址。有密码时写成 redis://:密码@127.0.0.1:6379/0
# 不要把真实密码写进这个示例文件。
HELLO_REDIS_URL=redis://127.0.0.1:6379/0

# 只监听本机。给局域网里别的机器用时再改，并同时设置 HELLO_ALLOWED_HOSTS。
HELLO_BIND=127.0.0.1
HELLO_PORT=8731

# 可选。客户端会访问的 Host 头，例如 192.0.2.10:8731
HELLO_ALLOWED_HOSTS=
